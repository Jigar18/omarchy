[Unit]
Description=Switch Omarchy theme and internal display refresh rate with AC power
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.local/state/omarchy/toggles/charging-based-theme

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-power-profile
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
